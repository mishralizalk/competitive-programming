#include <stdio.h>
#include <string.h>

int main() {
    char s[100005];
    char stack[100005];
    int top = -1, i, valid = 1;

    scanf("%100000s", s);

    for (i = 0; s[i] != '\0'; i++) {
        if (s[i] == '(' || s[i] == '[' || s[i] == '{') {
            stack[++top] = s[i];
        }
        else {
            if (top == -1) {
                valid = 0;
                break;
            }

            char ch = stack[top--];

            if ((s[i] == ')' && ch != '(') ||
                (s[i] == ']' && ch != '[') ||
                (s[i] == '}' && ch != '{')) {
                valid = 0;
                break;
            }
        }
    }

    if (top != -1)
        valid = 0;

    if (valid)
        printf("True\n");
    else
        printf("False\n");

    return 0;
}
