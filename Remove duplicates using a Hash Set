#include <stdio.h>

#define SIZE 200003

int hash[SIZE];
int used[SIZE];

int getHash(int x) {
    long long h = x;
    if (h < 0)
        h = -h;
    return h % SIZE;
}

int main() {
    int n, i, x, pos;
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        scanf("%d", &x);
        pos = getHash(x);

        while (used[pos] && hash[pos] != x)
            pos = (pos + 1) % SIZE;

        if (!used[pos]) {
            hash[pos] = x;
            used[pos] = 1;
            printf("%d ", x);
        }
    }

    printf("\n");
    return 0;
}
